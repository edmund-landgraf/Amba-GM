# Amba-GM server (Node 22.13+). Copy to .env — never commit .env.

PORT=3010
AMBA_GM_RUNTIME_ORIGIN=https://amba-gm.unwhelm.online

# Production (Phase B): campaign ledger on AMBA PostgreSQL. GM does not open SQLite.
AMBA_GM_RUNTIME_BACKEND=postgres
AMBA_GM_API_BASE=https://amba.unwhelm.online/api/v1

# Local visual review / optional SQLite campaign file:
# AMBA_GM_RUNTIME_BACKEND=sqlite
# AMBA_GM_RUNTIME_SECRET=
# AMBA_GM_DATA_DIR=.data
